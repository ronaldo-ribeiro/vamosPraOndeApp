platform :ios, '16.0'

target 'vamosPraOndeApp' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for vamosPraOndeApp
  # Firebase 11.x inclui os privacy manifests exigidos pela Apple (ITMS-91061).
  # No 11.x o FirebaseFirestoreSwift foi incorporado ao FirebaseFirestore.
  pod 'FirebaseAuth', '~> 11.0'
  pod 'FirebaseFirestore', '~> 11.0'
  # Login com a conta Google (Sign in with Apple é nativo, sem pod).
  # GoogleSignIn 8.x usa GTMSessionFetcher ~> 3.3; o Firebase 11.15 aceita >= 3.4,
  # então ambos convivem no GTMSessionFetcher 3.4.x.
  pod 'GoogleSignIn', '~> 8.0'
  # Pós-lançamento: relatório de crashes + uso do app.
  pod 'FirebaseCrashlytics', '~> 11.0'
  pod 'FirebaseAnalytics', '~> 11.0'

  target 'vamosPraOndeAppTests' do
    inherit! :search_paths
  end
end

# Garante compatibilidade com Xcode moderno:
# 1) forca o deployment target minimo de todos os Pods para 13.0,
#    evitando o erro de 'libarclite' ausente em targets antigos (iOS 8-11);
# 2) remove a flag invalida '-GCC_WARN_INHIBIT_ALL_WARNINGS' dos fontes do
#    BoringSSL-GRPC, que o clang moderno rejeita ('unsupported option -G').
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end

    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)
      phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']
        flags = file.settings['COMPILER_FLAGS']
        next unless flags.include?('-GCC_WARN_INHIBIT_ALL_WARNINGS')
        file.settings['COMPILER_FLAGS'] =
          flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ').strip
      end
    end
  end
end
