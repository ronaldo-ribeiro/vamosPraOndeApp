rules_version = '2';

// Regras de segurança do Firestore para o "Vamos pra Onde?".
// Cada usuário só pode ler e escrever os próprios destinos.
// Publique estas regras no console do Firebase (Firestore Database > Regras)
// ou via `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/destinations/{destinationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
